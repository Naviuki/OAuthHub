@model OAuthHub.Models.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="text-center py-5">
    <h1 class="display-4 text-danger"><i class="bi bi-exclamation-triangle"></i></h1>
    <h2>Произошла ошибка</h2>
    <p class="text-muted">Что-то пошло не так при обработке вашего запроса.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        <i class="bi bi-house me-1"></i>На главную
    </a>
</div>