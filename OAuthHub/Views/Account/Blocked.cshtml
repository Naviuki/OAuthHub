@{
    ViewData["Title"] = "Аккаунт заблокирован";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card shadow border-0 animate-fade-up">
            <div class="card-body p-5 text-center">
                <i class="bi bi-shield-exclamation display-1 text-danger"></i>
                <h2 class="mt-3 fw-bold">Аккаунт заблокирован</h2>
                <p class="text-muted mt-3 mb-4">
                    Ваш аккаунт был заблокирован администратором.
                    Все активные сессии завершены, доступ к функциям системы ограничен.
                </p>

                <div class="card border-warning bg-warning bg-opacity-10 mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-headset me-2"></i>Служба поддержки</h5>
                        <p class="mb-3">Для выяснения причин блокировки и восстановления доступа обратитесь в поддержку:</p>

                        <div class="d-flex flex-column gap-2 align-items-center">
                            <a href="mailto:support@oauthhub.com" class="btn btn-outline-primary hover-lift w-75">
                                <i class="bi bi-envelope-fill me-2"></i>support@oauthhub.com
                            </a>
                            <a href="https://t.me/oauthhub_support" target="_blank" class="btn btn-outline-info hover-lift w-75">
                                <i class="bi bi-telegram me-2"></i>Telegram: @@oauthhub_support
                            </a>
                        </div>

                        <p class="text-muted small mt-3 mb-0">
                            <i class="bi bi-clock me-1"></i>Среднее время ответа: до 24 часов
                        </p>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary hover-lift">
                        <i class="bi bi-house me-1"></i>На главную
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary hover-lift">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Попробовать войти
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>