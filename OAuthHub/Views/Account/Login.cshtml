@model OAuthHub.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<div class="row justify-content-center py-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 animate-fade-up">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-box-arrow-in-right display-6 text-primary"></i>
                    <h3 class="mt-2">Вход в аккаунт</h3>
                </div>

                @if (ViewBag.SessionTerminated == true)
                {
                    <div class="alert alert-warning animate-slide-down" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Сессия завершена.</strong> Ваша сессия была принудительно завершена администратором или с другого устройства. Войдите снова.
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="Email" autofocus />
                        <label asp-for="Email"><i class="bi bi-envelope me-1"></i>Email</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" placeholder="Пароль" />
                        <label asp-for="Password"><i class="bi bi-lock me-1"></i>Пароль</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Запомнить меня</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg hover-lift">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Войти
                    </button>
                </form>

                @if (Model.ExternalLogins.Any())
                {
                    <hr class="my-4" />
                    <p class="text-center text-muted mb-3">Или войдите через</p>
                    <div class="d-flex gap-2 flex-wrap justify-content-center">
                        @foreach (var provider in Model.ExternalLogins)
                        {
                            var iconClass = provider.Name.ToLower() switch
                            {
                                "google" => "bi-google",
                                "yandex" => "bi-browser-edge",
                                "mailru" => "bi-envelope-at",
                                _ => "bi-globe"
                            };
                            var btnClass = provider.Name.ToLower() switch
                            {
                                "google" => "btn-outline-danger",
                                "yandex" => "btn-outline-warning",
                                "mailru" => "btn-outline-primary",
                                _ => "btn-outline-secondary"
                            };

                            <form asp-action="ExternalLogin" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="@provider.Name" />
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <button type="submit" class="btn @btnClass hover-lift">
                                    <i class="bi @iconClass me-1"></i>@provider.DisplayName
                                </button>
                            </form>
                        }
                    </div>
                }

                <div class="text-center mt-4">
                    <span class="text-muted">Нет аккаунта?</span>
                    <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">
                        Зарегистрироваться
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}