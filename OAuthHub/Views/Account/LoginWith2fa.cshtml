@model OAuthHub.Models.ViewModels.LoginWith2faViewModel
@{
    ViewData["Title"] = "Двухфакторная аутентификация";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 animate-fade-up">
            <div class="card-body p-4 text-center">
                <i class="bi bi-shield-lock display-5 text-primary"></i>
                <h3 class="mt-2">Проверка безопасности</h3>
                <p class="text-muted">Введите 6-значный код из вашего приложения аутентификации (Google Authenticator, Яндекс.Ключ).</p>

                <form asp-action="LoginWith2fa" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RememberMe" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="TwoFactorCode" class="form-control text-center fs-4 fw-bold" autocomplete="off" placeholder="000000" maxlength="7" autofocus />
                        <label asp-for="TwoFactorCode">Код проверки</label>
                        <span asp-validation-for="TwoFactorCode" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3 text-start">
                        <input asp-for="RememberMachine" class="form-check-input" />
                        <label asp-for="RememberMachine" class="form-check-label">Запомнить этот браузер</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 hover-lift">
                        <i class="bi bi-check-circle me-2"></i>Войти
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}