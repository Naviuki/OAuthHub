@model List<OAuthHub.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Журнал аудита";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-journal-text me-2 text-secondary"></i> Журнал аудита</h3>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Назад</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Время</th>
                    <th>Пользователь</th>
                    <th>Действие</th>
                    <th>IP-адрес</th>
                    <th>Детали</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    var badgeClass = log.Action switch
                    {
                        "Блокировка" => "bg-danger",
                        "Разблокировка" => "bg-success",
                        "Вход" => "bg-primary",
                        "Вход OAuth" => "bg-info",
                        "Регистрация" => "bg-success",
                        "Регистрация OAuth" => "bg-info",
                        "Выход" => "bg-secondary",
                        "Сброс сессии админом" => "bg-warning text-dark",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td><small>@log.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")</small></td>
                        <td><small>@log.UserEmail</small></td>
                        <td><span class="badge @badgeClass">@log.Action</span></td>
                        <td><small class="text-muted">@log.IpAddress</small></td>
                        <td><small>@log.Details</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>