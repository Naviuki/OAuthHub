@model List<OAuthHub.Models.Entities.UserSession>
@{
    ViewData["Title"] = "Все сессии системы";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-display me-2 text-success"></i> Активные сеансы</h3>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Назад</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Пользователь</th>
                    <th>Устройство / IP</th>
                    <th>Активность</th>
                    <th>Статус</th>
                    <th class="text-end">Действие</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Model)
                {
                    <tr>
                        <td>
                            <small class="fw-bold">@session.User?.Email</small>
                        </td>
                        <td>
                            <small>@session.DeviceInfo</small>
                            <br /><small class="text-muted">IP: @session.IpAddress</small>
                        </td>
                        <td>
                            <small>Вход: @session.LoginTime.ToString("dd.MM HH:mm")</small>
                            <br /><small class="text-muted">Акт: @session.LastActivityTime.ToString("dd.MM HH:mm")</small>
                        </td>
                        <td>
                            @if (session.IsActive)
                            {
                                <span class="badge bg-success">Активна</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Завершена</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (session.IsActive)
                            {
                                <form asp-action="TerminateSession" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="sessionId" value="@session.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger hover-lift" onclick="return confirm('Завершить эту сессию принудительно?')">
                                        <i class="bi bi-x-circle me-1"></i> Сбросить
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>