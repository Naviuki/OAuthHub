@model OAuthHub.Models.ViewModels.ManageViewModel
@using Microsoft.AspNetCore.Identity
@using OAuthHub.Models.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Профиль";
    var user = await UserManager.GetUserAsync(User);
    var linkedLogins = user != null ? await UserManager.GetLoginsAsync(user) : new List<UserLoginInfo>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="text-center mb-4 animate-fade-up">
            <div class="position-relative d-inline-block">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="Аватар" class="rounded-circle shadow" width="96" height="96" />
                }
                else
                {
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow" style="width: 96px; height: 96px; font-size: 2rem;">
                        @(Model.DisplayName?[0].ToString().ToUpper() ?? "?")
                    </div>
                }
            </div>
            <h3 class="mt-3 mb-0">@(Model.DisplayName ?? "Пользователь")</h3>
            <p class="text-muted mb-1">@Model.Email</p>

            <!-- Иконки привязок соцсетей -->
            <div class="d-flex justify-content-center gap-2 mb-2">
                @if (linkedLogins.Any(l => l.LoginProvider.ToLower() == "google"))
                {
                    <span class="badge bg-danger rounded-pill px-2 py-1" title="Привязан Google"><i class="bi bi-google"></i></span>
                }
                @if (linkedLogins.Any(l => l.LoginProvider.ToLower() == "yandex"))
                {
                    <span class="badge bg-warning text-dark rounded-pill px-2 py-1" title="Привязан Яндекс"><i class="bi bi-browser-edge"></i></span>
                }
                @if (linkedLogins.Any(l => l.LoginProvider.ToLower() == "mailru"))
                {
                    <span class="badge bg-primary rounded-pill px-2 py-1" title="Привязан Mail.ru"><i class="bi bi-envelope-at"></i></span>
                }
            </div>

            <small class="text-muted">
                <i class="bi bi-calendar me-1"></i>Зарегистрирован: @Model.CreatedAt.ToString("dd.MM.yyyy")
            </small>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-md-3">
                <div class="card border-0 shadow-sm text-center hover-lift animate-fade-up">
                    <div class="card-body">
                        <i class="bi bi-link-45deg fs-3 text-primary"></i>
                        <h5 class="mt-2 mb-0">@Model.ExternalLoginsCount</h5>
                        <small class="text-muted">Привязки</small>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card border-0 shadow-sm text-center hover-lift animate-fade-up">
                    <div class="card-body">
                        <i class="bi bi-display fs-3 text-success"></i>
                        <h5 class="mt-2 mb-0">@Model.ActiveSessionsCount</h5>
                        <small class="text-muted">Сессии</small>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card border-0 shadow-sm text-center hover-lift animate-fade-up">
                    <div class="card-body">
                        <i class="bi bi-shield-check fs-3 @(Model.TwoFactorEnabled ? "text-success" : "text-warning")"></i>
                        <h5 class="mt-2 mb-0">@(Model.TwoFactorEnabled ? "Вкл" : "Выкл")</h5>
                        <small class="text-muted">2FA</small>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card border-0 shadow-sm text-center hover-lift animate-fade-up">
                    <div class="card-body">
                        <i class="bi bi-key fs-3 @(Model.HasPassword ? "text-success" : "text-danger")"></i>
                        <h5 class="mt-2 mb-0">@(Model.HasPassword ? "Есть" : "Нет")</h5>
                        <small class="text-muted">Пароль</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="list-group shadow-sm animate-fade-up">
            <a asp-action="ChangePassword" class="list-group-item list-group-item-action d-flex align-items-center py-3 hover-bg">
                <i class="bi bi-key me-3 fs-5 text-primary"></i>
                <div>
                    <strong>@(Model.HasPassword ? "Сменить пароль" : "Установить пароль")</strong>
                    <br /><small class="text-muted">Обновите пароль для входа в систему</small>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
            <a asp-action="ExternalLogins" class="list-group-item list-group-item-action d-flex align-items-center py-3 hover-bg">
                <i class="bi bi-link-45deg me-3 fs-5 text-success"></i>
                <div>
                    <strong>Внешние аккаунты</strong>
                    <br /><small class="text-muted">Управляйте привязанными соцсетями (@Model.ExternalLoginsCount)</small>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
            <a asp-controller="Session" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center py-3 hover-bg">
                <i class="bi bi-display me-3 fs-5 text-info"></i>
                <div>
                    <strong>Активные сессии</strong>
                    <br /><small class="text-muted">Просмотрите и завершите сессии (@Model.ActiveSessionsCount активных)</small>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
            <a asp-action="TwoFactorAuthentication" class="list-group-item list-group-item-action d-flex align-items-center py-3 hover-bg">
                <i class="bi bi-shield-lock me-3 fs-5 text-warning"></i>
                <div>
                    <strong>Двухфакторная аутентификация</strong>
                    <br /><small class="text-muted">Статус: @(Model.TwoFactorEnabled ? "включена" : "выключена")</small>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
            <a asp-controller="ExportImport" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center py-3 hover-bg">
                <i class="bi bi-download me-3 fs-5 text-secondary"></i>
                <div>
                    <strong>Экспорт данных</strong>
                    <br /><small class="text-muted">Скачайте ваши данные в JSON или CSV</small>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
            <a asp-action="DeleteAccount" class="list-group-item list-group-item-action d-flex align-items-center py-3 hover-bg">
                <i class="bi bi-trash me-3 fs-5 text-danger"></i>
                <div>
                    <strong class="text-danger">Удалить аккаунт</strong>
                    <br /><small class="text-muted">Необратимое удаление всех данных</small>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </a>
        </div>
    </div>
</div>