@model OAuthHub.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = Model.HasPassword ? "Смена пароля" : "Установка пароля";
}

<div class="row justify-content-center py-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 animate-fade-up">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-key display-6 text-primary"></i>
                    <h3 class="mt-2">@ViewData["Title"]</h3>
                </div>

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    @if (Model.HasPassword)
                    {
                        <div class="form-floating mb-3">
                            <input asp-for="OldPassword" class="form-control" placeholder="Текущий пароль" />
                            <label asp-for="OldPassword">Текущий пароль</label>
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>
                    }

                    <div class="form-floating mb-3">
                        <input asp-for="NewPassword" class="form-control" placeholder="Новый пароль" />
                        <label asp-for="NewPassword">Новый пароль</label>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Подтверждение" />
                        <label asp-for="ConfirmNewPassword">Подтверждение нового пароля</label>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <input type="hidden" asp-for="HasPassword" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg hover-lift">
                            <i class="bi bi-check-circle me-2"></i>Сохранить
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Назад
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}